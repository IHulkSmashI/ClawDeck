{
  "name": "clawdeck",
  "version": "0.1.0",
  "description": "ClawDeck - what Bazzite does not do for the MSI Claw: XeSS on XMX with XeLL, the VRR and face-button fixes, power profiles with autotune",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "python3 -m pytest -q tests",
    "preview": "node preview/build.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IHulkSmashI/ClawDeck.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "msi-claw",
    "intel",
    "panther-lake",
    "bazzite",
    "steamos"
  ],
  "author": "IHulkSmashI",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/IHulkSmashI/ClawDeck/issues"
  },
  "homepage": "https://github.com/IHulkSmashI/ClawDeck#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.65.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/webpack": "^5.28.5",
    "esbuild": "0.28.2",
    "rollup": "^4.65.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    }
  }
}
