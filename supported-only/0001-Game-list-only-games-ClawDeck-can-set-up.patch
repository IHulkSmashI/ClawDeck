 py_modules/clawdeck/gamedb.py | 21 ++++++++++++++++++++-
 src/api.ts                    |  2 +-
 src/tabs/Game.tsx             | 17 +++++++++++++----
 tests/test_modules.py         |  8 ++++++++
 5 files changed, 73 insertions(+), 6 deletions(-)

diff --git a/main.py b/main.py
index 5f7f7e9..39864db 100644
--- a/main.py
+++ b/main.py
@@ -666,12 +666,43 @@ class Plugin:
     async def games_list(self) -> list[dict]:
         """Installed Steam games for the Games page, with what ClawDeck has set up in each."""
         games = await self._bg(xess.installed_games, HOME)
+        games = await self._bg(self._with_support, games)
         ours = self.settings.get("opti_games") or {}
         for g in games:
             launch = self.profiles.get_launch(g["appid"])
             g["setup"] = "optiscaler" if g["appid"] in ours else "launch" if launch else None
         return games
 
+    def _with_support(self, games: list[dict]) -> list[dict]:
+        """Which installed games ClawDeck can set up (the Game list shows only those, as the supported-games list does). Walking a
+        game folder is slow on an SD card, so the answer is kept per game until its folder changes."""
+        path = os.path.join(RUNTIME_DIR, "support-cache.json")
+        try:
+            with open(path, "r", encoding="utf-8") as f:
+                cache = json.load(f)
+        except (OSError, ValueError):
+            cache = {}
+        doc = gamedb.load(GAMES)
+        changed = False
+        for g in games:
+            try:
+                stamp = int(os.stat(g["dir"]).st_mtime)
+            except OSError:
+                stamp = 0
+            c = cache.get(g["appid"])
+            if not c or c.get("stamp") != stamp:
+                c = {**gamedb.support(doc, g["dir"]), "stamp": stamp}
+                cache[g["appid"]] = c
+                changed = True
+            g["supported"], g["via"] = c["ok"], c["via"]
+        if changed:
+            try:
+                with open(path, "w", encoding="utf-8") as f:
+                    json.dump(cache, f)
+            except OSError:
+                pass
+        return games
+
     async def game_recommend(self, appid: str) -> dict:
         rec, d, folder = await self._bg(self._rec, appid)
         launch = self.profiles.get_launch(appid)
diff --git a/py_modules/clawdeck/gamedb.py b/py_modules/clawdeck/gamedb.py
index 037f706..a7f83b2 100644
--- a/py_modules/clawdeck/gamedb.py
+++ b/py_modules/clawdeck/gamedb.py
@@ -13,7 +13,7 @@ from __future__ import annotations
 import json
 import os
 
-DEPTH = 4
+DEPTH = 6
 KEY_RE = r"^[A-Za-z][A-Za-z0-9]*_[A-Za-z0-9_]+$"
 
 
@@ -121,3 +121,22 @@ def recommend(doc: dict, game_dir: str | None) -> dict:
         "source_commit": doc.get("optiscaler_commit"), "exes": exes[:8],
         "main_exes": [e.lower() for e in (g or {}).get("exes", [])] + [e for e in exes if e in {x.lower() for x in doc.get("re_engine_exes", [])}],
     }
+
+
+UPSCALER_FILES = {
+    "DLSS": ("nvngx_dlss.dll", "sl.dlss.dll", "nvngx_dlssd.dll"),
+    "FSR": ("amd_fidelityfx_upscaler_dx12.dll", "amd_fidelityfx_dx12.dll", "ffx_fsr2_api_x64.dll", "ffx_fsr2_api_dx12_x64.dll",
+            "ffx_fsr3upscaler_x64.dll", "amd_fidelityfx_vk.dll"),
+    "XeSS": ("libxess*",),
+}
+
+
+def support(doc: dict, game_dir: str | None) -> dict:
+    """Can ClawDeck set this game up? Yes when it is in the per-game list, or ships an upscaler OptiScaler takes over
+    (DLSS, FSR 2/3/3.1) or XeSS of its own. Unreal games often keep DLSS in a plugin folder, which DEPTH covers."""
+    if not game_dir or not os.path.isdir(game_dir):
+        return {"ok": False, "via": []}
+    via = [k for k, names in UPSCALER_FILES.items() if _has(game_dir, names)]
+    if match(doc, exes_in(game_dir)):
+        via.append("list")
+    return {"ok": bool(via), "via": via}
